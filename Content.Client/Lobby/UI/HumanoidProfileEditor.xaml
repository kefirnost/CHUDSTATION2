<BoxContainer xmlns="https://spacestation14.io"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
             xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
             xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
             xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
             HorizontalExpand="True"
             SeparationOverride="10">
    <BoxContainer Orientation="Vertical" MinWidth="250" VerticalExpand="True" SeparationOverride="8">
        <PanelContainer StyleClasses="BackgroundPanel" VerticalExpand="True">
            <profile:ProfilePreviewSpriteView Name="SpriteView" Scale="8 8" Margin="4" />
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="4">
            <Button Name="SpriteRotateLeft" Text="◀" />
            <Button Name="SpriteRotateRight" Text="▶" />
            <Button Name="ShowClothes" Pressed="True" ToggleMode="True"
                    Text="{Loc 'humanoid-profile-editor-clothing-show'}" />
        </BoxContainer>
        <PanelContainer Name="ProfileHighlight" StyleClasses="BackgroundPanel">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="5">
                <Button Name="SaveButton" Text="{Loc 'humanoid-profile-editor-save-button'}" />
                <Button Name="ResetButton" Disabled="True" Text="{Loc 'humanoid-profile-editor-reset-button'}" />
                <GridContainer Columns="2" HSeparationOverride="4" VSeparationOverride="4">
                    <Button Name="ImportButton" Text="{Loc 'humanoid-profile-editor-import-button'}" />
                    <Button Name="ExportButton" Text="{Loc 'humanoid-profile-editor-export-button'}" />
                    <Button Name="ExportImageButton" Text="{Loc 'humanoid-profile-editor-export-image-button'}" />
                    <Button Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}" />
                </GridContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
        <PanelContainer StyleClasses="BackgroundPanel">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="5">
                <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                    <Label Text="{Loc 'humanoid-profile-editor-name-label'}" VAlign="Center" />
                    <LineEdit Name="NameEdit" HorizontalExpand="True" VerticalAlignment="Center" />
                </BoxContainer>
                <RichTextLabel Name="WarningLabel" HorizontalExpand="True" />
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <Label Text="{Loc 'humanoid-profile-editor-randomize'}" VAlign="Center" />
                    <Control HorizontalExpand="True" />
                    <Button Name="RandomizeUnlockedButton" Text="{Loc 'humanoid-profile-editor-randomize-unlocked-button'}" />
                </BoxContainer>
                <GridContainer Columns="3" HSeparationOverride="4" VSeparationOverride="4">
                    <ui:RandomizeLockButton For="Name" LabelText="{Loc 'humanoid-profile-editor-randomize-name-button'}" />
                    <ui:RandomizeLockButton For="Species" LabelText="{Loc 'humanoid-profile-editor-randomize-species-button'}" />
                    <ui:RandomizeLockButton For="Age" LabelText="{Loc 'humanoid-profile-editor-randomize-age-button'}" />
                    <ui:RandomizeLockButton For="Height" LabelText="{Loc 'humanoid-profile-editor-randomize-height-button'}" />
                    <ui:RandomizeLockButton For="Width" LabelText="{Loc 'humanoid-profile-editor-randomize-width-button'}" />
                    <ui:RandomizeLockButton For="Sex" LabelText="{Loc 'humanoid-profile-editor-randomize-sex-button'}" />
                    <ui:RandomizeLockButton For="Skin" LabelText="{Loc 'humanoid-profile-editor-randomize-skin-button'}" />
                    <ui:RandomizeLockButton For="Eyes" LabelText="{Loc 'humanoid-profile-editor-randomize-eye-button'}" />
                    <ui:RandomizeLockButton For="Markings" LabelText="{Loc 'humanoid-profile-editor-randomize-markings-button'}" />
                </GridContainer>
            </BoxContainer>
        </PanelContainer>
        <TabContainer Name="TabContainer" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical">
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                            <Label Text="{Loc 'humanoid-profile-editor-species-label'}" VAlign="Center" />
                            <Control HorizontalExpand="True" />
                            <TextureButton Name="SpeciesInfoButton" Scale="0.3 0.3" VerticalAlignment="Center"
                                           ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}" />
                            <OptionButton Name="SpeciesButton" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'humanoid-profile-editor-age-label'}" VAlign="Center" />
                            <Control HorizontalExpand="True" />
                            <LineEdit Name="AgeEdit" MinSize="56 0" />
                        </BoxContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="3">
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc 'humanoid-profile-editor-height-label'}" />
                                <Control HorizontalExpand="True" />
                                <Label Name="HeightValueLabel" Text="100%" />
                            </BoxContainer>
                            <Slider Name="HeightSlider" MinValue="0.8" MaxValue="1.2" Value="1" HorizontalExpand="True" />
                        </BoxContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="3">
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc 'humanoid-profile-editor-width-label'}" />
                                <Control HorizontalExpand="True" />
                                <Label Name="WidthValueLabel" Text="100%" />
                            </BoxContainer>
                            <Slider Name="WidthSlider" MinValue="0.85" MaxValue="1.15" Value="1" HorizontalExpand="True" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'humanoid-profile-editor-sex-label'}" />
                            <Control HorizontalExpand="True" />
                            <OptionButton Name="SexButton" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'humanoid-profile-editor-voice-label'}" />
                            <Control HorizontalExpand="True" />
                            <OptionButton Name="VoiceButton" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}" />
                            <Control HorizontalExpand="True" />
                            <OptionButton Name="PronounsButton" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}" />
                            <Control HorizontalExpand="True" />
                            <OptionButton Name="SpawnPriorityButton" />
                        </BoxContainer>
                        <Label Text="{Loc 'humanoid-profile-editor-skin-color-label'}" />
                        <Slider Name="Skin" MinValue="0" MaxValue="100" Value="20" HorizontalExpand="True" />
                        <BoxContainer Name="RgbSkinColorContainer" Visible="False" Orientation="Vertical" HorizontalExpand="True" />
                        <Label Text="{Loc 'humanoid-profile-editor-eyes-label'}" />
                        <humanoid:EyeColorPicker Name="EyeColorPicker" />
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical">
                <OptionButton Name="PreferenceUnavailableButton" />
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="JobList" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" Margin="10">
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="AntagList" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" Margin="10">
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="TraitsList" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
            <BoxContainer Name="MarkingsTab" Orientation="Vertical" Margin="10">
                <humanoid:MarkingPicker Name="Markings" HorizontalExpand="True" VerticalExpand="True" />
            </BoxContainer>
        </TabContainer>
    </BoxContainer>
</BoxContainer>
<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         VerticalExpand="True">
    <PanelContainer Name="BackgroundPanel">
        <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal" MinSize="0 40" SeparationOverride="5">
                <Label Text="{Loc 'character-setup-gui-character-setup-label'}"
                       Margin="6 0" VAlign="Center" StyleClasses="LabelHeadingBigger"
                       HorizontalExpand="True" />
                <Button Name="StatsButton" Text="{Loc 'character-setup-gui-character-setup-stats-button'}"
                        StyleClasses="ButtonBig" />
                <cc:CommandButton Name="AdminRemarksButton" Command="adminremarks"
                                  Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"
                                  StyleClasses="ButtonBig" />
                <Button Name="RulesButton" Text="{Loc 'character-setup-gui-character-setup-rules-button'}"
                        StyleClasses="ButtonBig" />
                <Button Name="CloseButton" Access="Public"
                        Text="{Loc 'character-setup-gui-character-setup-close-button'}"
                        StyleClasses="ButtonBig" />
            </BoxContainer>
            <PanelContainer StyleClasses="BackgroundPanel">
                <ScrollContainer HScrollEnabled="True" VScrollEnabled="False" Margin="5" MinHeight="150">
                    <BoxContainer Name="Characters" Orientation="Horizontal" SeparationOverride="6" />
                </ScrollContainer>
            </PanelContainer>
            <BoxContainer Name="CharEditor" HorizontalExpand="True" VerticalExpand="True" />
        </BoxContainer>
    </PanelContainer>
</Control>
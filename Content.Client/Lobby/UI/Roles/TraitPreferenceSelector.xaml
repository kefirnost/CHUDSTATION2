<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <PanelContainer Name="CardPanel"
                    StyleClasses="BackgroundPanel"
                    HorizontalExpand="True"
                    Margin="0 4">
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="12"
                      Margin="8">
            <PanelContainer Name="IconPanel"
                            StyleClasses="BackgroundPanelDark"
                            SetSize="104 104">
                <BoxContainer Orientation="Vertical"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <TextureRect Name="Icon"
                                 SetSize="88 88"
                                 CanShrink="True"
                                 Stretch="KeepAspectCentered"
                                 Visible="False" />
                    <Label Name="IconPlaceholder"
                           Text="ICON"
                           StyleClasses="LabelSubText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          SeparationOverride="4"
                          Margin="0 4">
                <BoxContainer Orientation="Horizontal"
                              HorizontalExpand="True"
                              SeparationOverride="8">
                    <Label Name="TitleLabel"
                           HorizontalExpand="True"
                           VerticalAlignment="Center"
                           StyleClasses="LabelHeadingBigger" />
                    <CheckBox Name="Checkbox"
                              Access="Public"
                              VerticalAlignment="Center" />
                </BoxContainer>
                <RichTextLabel Name="DescriptionLabel"
                               HorizontalExpand="True"
                               VerticalExpand="True" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</Control>

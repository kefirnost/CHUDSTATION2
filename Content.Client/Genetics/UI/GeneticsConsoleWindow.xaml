<controls:FancyWindow xmlns="https://spacestation14.io"
                         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                         Title="{Loc 'genetics-console-title'}"
                         MinSize="700 520"
                         SetSize="900 680">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="10">
        <Label Name="ConsoleStatusLabel" />
        <Label Name="StorageStatusLabel" />
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      VerticalExpand="True">
            <PanelContainer MinWidth="260"
                            VerticalExpand="True"
                            StyleClasses="PanelDeep">
                <BoxContainer Orientation="Vertical"
                              VerticalExpand="True"
                              Margin="6">
                    <Label Text="{Loc 'genetics-console-potential-title'}" />
                    <ScrollContainer HScrollEnabled="False"
                                    VerticalExpand="True">
                        <BoxContainer Name="GeneList"
                                      Orientation="Vertical"
                                      VerticalExpand="True" />
                    </ScrollContainer>
                    <Label Text="{Loc 'genetics-console-upgrades-title'}" />
                    <ScrollContainer HScrollEnabled="False"
                                    MinSize="0 120"
                                    VerticalExpand="True">
                        <BoxContainer Name="UpgradeList"
                                      Orientation="Vertical"
                                      VerticalExpand="True" />
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          Margin="10 0 0 0">
                <Label Name="GeneNameLabel" />
                <RichTextLabel Name="GeneDescriptionLabel"
                               HorizontalExpand="True" />
                <Label Name="SequenceProgressLabel" />
                <Label Text="{Loc 'genetics-console-sequence-hint'}" />
                <LineEdit Name="SequenceInput"
                          HorizontalExpand="True" />
                <BoxContainer Orientation="Horizontal">
                    <Button Name="ResearchButton"
                            Text="{Loc 'genetics-console-research-button'}" />
                    <Button Name="SequenceButton"
                            Text="{Loc 'genetics-console-sequence-button'}" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="ActivateButton"
                            Text="{Loc 'genetics-console-activate-button'}" />
                    <Button Name="DeactivateButton"
                            Text="{Loc 'genetics-console-deactivate-button'}" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="ActivatorButton"
                            Text="{Loc 'genetics-console-create-activator-button'}" />
                    <Button Name="InjectorButton"
                            Text="{Loc 'genetics-console-create-injector-button'}" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="StoreButton"
                            Text="{Loc 'genetics-console-store-button'}" />
                    <Button Name="ReclaimButton"
                            Text="{Loc 'genetics-console-reclaim-button'}" />
                </BoxContainer>
                <Label Text="{Loc 'genetics-console-splice-title'}" />
                <BoxContainer Orientation="Horizontal">
                    <Button Name="SpliceStabilizerButton"
                            Text="{Loc 'genetics-console-splice-stabilizer'}" />
                    <Button Name="SpliceSynchronizerButton"
                            Text="{Loc 'genetics-console-splice-synchronizer'}" />
                    <Button Name="SpliceWeakenerButton"
                            Text="{Loc 'genetics-console-splice-weakener'}" />
                </BoxContainer>
                <Control VerticalExpand="True" />
                <Label Name="GeneStatusLabel" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
